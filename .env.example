# Database Configuration (Host port 5433 mapped to Docker pgvector)
DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@localhost:5433/job_match_db
DATABASE_URL_TEST=postgresql+psycopg://postgres:postgrespassword@localhost:5433/job_match_test_db

# Security & Authentication
ADMIN_API_KEY=dev-admin-api-key-do-not-use-in-production
JWT_SECRET=dev-jwt-secret-key-minimum-32-chars-long-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Embeddings & Vector Search
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# LLM Provider ("mock", "gemini", "openai", "anthropic")
LLM_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Deterministic Ranking Weights (Must sum to 1.0)
RANKING_WEIGHT_SEMANTIC=0.35
RANKING_WEIGHT_SKILLS=0.30
RANKING_WEIGHT_EXPERIENCE=0.20
RANKING_WEIGHT_PREFERENCES=0.15

# Server & CORS
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
